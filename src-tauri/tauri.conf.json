{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Mandala",
  "version": "0.1.0",
  "identifier": "fr.brandonviryel.studio-mandala",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Studio Mandala",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self' tauri:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' tauri: asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Composition de mandalas par couches",
    "longDescription": "Application hors ligne pour composer, enregistrer et exporter des mandalas paramétriques.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
