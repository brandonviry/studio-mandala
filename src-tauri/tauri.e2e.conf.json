{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "description": "Capacité réservée au binaire de test non distribué.",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "fs:allow-read-text-file",
            "fs:allow-write-text-file",
            "fs:allow-write-file",
            {
              "identifier": "fs:scope",
              "allow": [
                { "path": "$TEMP/mandala-e2e/**" }
              ]
            },
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
