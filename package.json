{
  "name": "mandala-layers-studio",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Studio desktop hors ligne de mandalas composés par couches.",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run --project unit",
    "test:renderer": "vitest run --project renderer",
    "test:coverage": "vitest run --project unit --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:browser-e2e": "playwright test",
    "build:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/e2e/run-desktop.ps1 -BuildOnly",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/e2e/run-desktop.ps1",
    "test:perf:smoke": "vitest run tests/performance/smoke.test.ts",
    "test:perf:stress": "vitest run tests/performance/stress.test.ts",
    "build": "vite build",
    "package:windows": "tauri build --bundles nsis",
    "test:package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/package/windows-smoke.ps1 -Install",
    "test:package:windows:artifact": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/package/windows-smoke.ps1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "^7.7.3",
    "@wdio/native-types": "2.4.0",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "eslint": "^4.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "playwright": "1.62.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
